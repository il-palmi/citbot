# Copia questo file in ".env" e inserisci il tuo token
DISCORD_TOKEN=il-tuo-token-qui
# Prefisso dei comandi (opzionale, default "!")
BOT_PREFIX=!
# ID del server Discord e del ruolo autorizzato a usare i comandi di amministrazione
# (!add, !remove). Necessari per verificare i ruoli anche quando il comando
# arriva in chat privata, dove Discord non fornisce i ruoli del membro.
GUILD_ID=id-del-server
ADMIN_ROLE_ID=id-del-ruolo
